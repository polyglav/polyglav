{
  "name": "polyglav-core-web",
  "version": "0.14.0",
  "description": "Web tools - search (DuckDuckGo) and page fetching - bundled with polyglav",
  "polyglav_version": ">=0.13.0,<1.0",
  "python": ">=3.11",
  "entry": "src/plugin.py",
  "provides": {
    "tools": [
      "web_fetch",
      "web_search"
    ],
    "providers": [],
    "commands": [],
    "config": {
      "query_refine": {
        "default": false,
        "description": "Auto-refine short web-search queries"
      },
      "query_refine_context": {
        "default": 4,
        "description": "Recent-message context for refinement"
      },
      "query_refine_min_words": {
        "default": 3,
        "description": "Minimum query length before refinement applies"
      },
      "search_results": {
        "default": 10,
        "description": "Number of search results to fetch"
      }
    }
  }
}