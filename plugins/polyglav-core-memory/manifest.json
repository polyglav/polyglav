{
  "name": "polyglav-core-memory",
  "version": "0.1.0",
  "description": "Memory commands and summaries - bundled with polyglav",
  "polyglav_version": ">=0.49.0,<1.0",
  "python": ">=3.11",
  "entry": "src/plugin.py",
  "provides": {
    "tools": [],
    "providers": [],
    "commands": [
      "/memorize"
    ],
    "services": [
      "memory"
    ],
    "config": {
      "memory": {
        "default": true,
        "description": "Enable bounded memory summaries under .polyglav/memory/"
      },
      "memory_max_chars": {
        "default": 2000,
        "description": "Cap characters of an injected memory summary"
      },
      "memory_scopes": {
        "default": {
          "role": true,
          "team": true,
          "job": true
        },
        "description": "Per-scope memory toggles"
      }
    }
  }
}
