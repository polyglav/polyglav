services:
  docs-agent:
    build:
      context: .
    environment:
      POLYGLAV_PORT: 8781
      POLYGLAV_PATH: /srv/docs
      POLYGLAV_TOKEN: ${POLYGLAV_TOKEN:?set POLYGLAV_TOKEN before starting the fleet}
    volumes:
      - ./agents/docs:/srv/docs
    ports:
      - "127.0.0.1:8781:8781"
    restart: unless-stopped
    deploy:
      resources:
        limits:
          cpus: "1"
          memory: 512M

  code-agent:
    build:
      context: .
    environment:
      POLYGLAV_PORT: 8782
      POLYGLAV_PATH: /srv/src
      POLYGLAV_TOKEN: ${POLYGLAV_TOKEN:?set POLYGLAV_TOKEN before starting the fleet}
    volumes:
      - ./agents/src:/srv/src
    ports:
      - "127.0.0.1:8782:8782"
    restart: unless-stopped
    deploy:
      resources:
        limits:
          cpus: "1"
          memory: 512M
