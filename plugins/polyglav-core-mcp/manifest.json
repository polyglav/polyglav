{
  "name": "polyglav-core-mcp",
  "version": "0.16.0",
  "description": "Model Context Protocol client and server - bundled with polyglav",
  "polyglav_version": ">=0.16.0,<1.0",
  "python": ">=3.11",
  "entry": "src/plugin.py",
  "provides": {
    "tools": [
      "mcp_connect",
      "mcp_list",
      "mcp_disconnect"
    ],
    "providers": [],
    "commands": [
      "/mcp"
    ],
    "config": {
      "mcp.servers": {
        "default": [],
        "description": "MCP client server definitions"
      },
      "mcp_server.allow_ask": {
        "default": true,
        "description": "When serving MCP, run ask-policy tools vs refuse them"
      }
    }
  }
}
