{
  "name": "polyglav-core-jobs",
  "version": "0.1.0",
  "description": "Scheduled and durable jobs - bundled with polyglav",
  "polyglav_version": ">=0.49.0,<1.0",
  "python": ">=3.11",
  "entry": "src/plugin.py",
  "provides": {
    "tools": [],
    "providers": [],
    "commands": [
      "/jobs"
    ],
    "services": [
      "job_registry",
      "job_scheduler",
      "job_service"
    ],
    "config": {
      "jobs.supervisor": {
        "default": "assistant",
        "description": "Role that answers job escalations"
      }
    }
  }
}
